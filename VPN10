allow-lan: false
bind-address: 127.0.0.1
mixed-port: 7890
mode: rule
log-level: info

external-controller: 127.0.0.1:9090

ipv6: false
unified-delay: true
tcp-concurrent: true

profile:
  store-selected: true
  store-fake-ip: true

# 域名嗅探：当应用自行解析 DNS 时，尽量从 HTTP/TLS/QUIC 恢复域名，避免 ChatGPT 流量落入普通兜底。
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

# 必须在 Clash Verge 中实际开启 TUN/服务模式，并检查最终运行配置未被 GUI 覆盖。
tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53

dns:
  enable: true
  listen: 127.0.0.1:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  use-system-hosts: true
  respect-rules: true
  prefer-h3: false

  # 只用于解析上游 DNS 的域名；使用加密协议，避免明文引导查询。
  default-nameserver:
    - tls://223.5.5.5
    - tls://223.6.6.6

  # 代理节点域名以及 DIRECT 出口使用国内加密 DNS。
  proxy-server-nameserver: &domestic_dns
    - "https://dns.alidns.com/dns-query#DIRECT"
    - "https://doh.pub/dns-query#DIRECT"
  direct-nameserver: *domestic_dns

  # 默认真实解析使用境外 DoH，并强制经过不含 DIRECT 的自动选择组。
  nameserver:
    - "https://1.1.1.1/dns-query#♻️ 自动选择"
    - "https://8.8.8.8/dns-query#♻️ 自动选择"

  nameserver-policy:
    # 国内及私有域名使用国内加密 DNS。
    "geosite:cn,private": *domestic_dns

    # ChatGPT / OpenAI：主域名、官方 geosite 与关键共享依赖统一使用 ChatGPT 住宅机场解析。
    "geosite:openai": &chatgpt_dns
      - "https://1.1.1.1/dns-query#👽 ChatGPT"
      - "https://8.8.8.8/dns-query#👽 ChatGPT"
    "+.chatgpt.com": *chatgpt_dns
    "+.openai.com": *chatgpt_dns
    "+.oaistatic.com": *chatgpt_dns
    "+.oaiusercontent.com": *chatgpt_dns
    "+.oaistatsig.com": *chatgpt_dns
    "+.openaimerge.com": *chatgpt_dns
    "+.workos.com": *chatgpt_dns
    "+.workoscdn.com": *chatgpt_dns
    "workos.imgix.net": *chatgpt_dns
    "o207216.ingest.sentry.io": *chatgpt_dns
    "o33249.ingest.sentry.io": *chatgpt_dns
    "+.ct.sendgrid.net": *chatgpt_dns
    "+.intercom.io": *chatgpt_dns
    "+.intercomcdn.com": *chatgpt_dns
    "challenges.cloudflare.com": *chatgpt_dns
    "humb.apple.com": *chatgpt_dns
    "js.stripe.com": *chatgpt_dns
    "rum.browser-intake-datadoghq.com": *chatgpt_dns

  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - localhost
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "ntp.*.com"
    - time1.cloud.tencent.com

proxy-providers:
  # 通用订阅：与第二订阅共同供 ChatGPT 之外的策略组使用。
  "✈️ 我的机场":
    type: http
    url: "https://feed.iggv5.com/c/76c8d23a-f597-4f5a-a0c0-3bf2ccd93344/platform/clash/iGG-iGuge"
    interval: 3600
    path: ./wodejichang.yaml
    health-check:
      enable: true
      interval: 300
      timeout: 5000
      lazy: true
      url: https://www.gstatic.com/generate_204
      expected-status: 204

  # 第二订阅：ChatGPT 只使用本订阅；本订阅也加入其他通用策略组。
  "👽 ChatGPT机场":
    type: http
    url: "https://ipequal.com/use/unsafe/sub.php?&s=6fd4ed1cc40906023d8715132fc91a1c35023056813e79fd3b72510fc3d81634"
    interval: 3600
    path: ./wodejichang-chatgpt.yaml
    override:
      additional-prefix: "[GPT] "
    health-check:
      enable: true
      interval: 60
      timeout: 5000
      lazy: false
      url: https://chatgpt.com/cdn-cgi/trace
      expected-status: 200

proxy-groups:
  - name: "🔰 节点选择"
    type: select
    proxies:
      - "♻️ 自动选择"
      - "⚖️ 负载均衡"
      - "🎯 本地直连"
    use:
      - "✈️ 我的机场"
      - "👽 ChatGPT机场"

  # ChatGPT 总入口：
  - name: "👽 ChatGPT"
    type: select
    proxies:
      - "👽 ChatGPT 自动"
    use:
      - "👽 ChatGPT机场"
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 60
    timeout: 5000
    lazy: false
    expected-status: 200

  # ChatGPT 自动择优：
  # 按测速结果自动选择延迟较低节点；tolerance=100 ms 用于减少频繁来回切换。
  - name: "👽 ChatGPT 自动"
    type: url-test
    use:
      - "👽 ChatGPT机场"
    url: https://chatgpt.com/cdn-cgi/trace
    interval: 60
    timeout: 5000
    lazy: false
    expected-status: 200
    tolerance: 100

  - name: "♻️ 自动选择"
    type: url-test
    use:
      - "✈️ 我的机场"
      - "👽 ChatGPT机场"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50

  - name: "⚖️ 负载均衡"
    type: load-balance
    strategy: consistent-hashing
    use:
      - "✈️ 我的机场"
      - "👽 ChatGPT机场"

  - name: "🌍 国外媒体"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "⚖️ 负载均衡"
      - "🎯 本地直连"
    use:
      - "✈️ 我的机场"
      - "👽 ChatGPT机场"

  - name: "🌏 国内媒体"
    type: select
    proxies:
      - "🎯 本地直连"
      - "🔰 节点选择"

  - name: "📲 电报信息"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🎯 本地直连"
    use:
      - "✈️ 我的机场"
      - "👽 ChatGPT机场"

  - name: "🎯 本地直连"
    type: select
    proxies:
      - DIRECT

  - name: "🐟 漏网之鱼"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "⚖️ 负载均衡"
      - "🎯 本地直连"

