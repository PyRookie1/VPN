allow-lan: false
bind-address: 127.0.0.1
mixed-port: 7890
mode: rule
log-level: info

external-controller: 127.0.0.1:9090

ipv6: false
unified-delay: true
tcp-concurrent: true

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53

dns:
  enable: true
  listen: 127.0.0.1:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  use-system-hosts: true
  respect-rules: true
  prefer-h3: false

  default-nameserver:
    - tls://223.5.5.5
    - tls://223.6.6.6

  proxy-server-nameserver: &domestic_dns
    - "https://dns.alidns.com/dns-query#DIRECT"
    - "https://doh.pub/dns-query#DIRECT"
  direct-nameserver: *domestic_dns

  nameserver:
    - "https://1.1.1.1/dns-query#🔰 节点选择"
    - "https://8.8.8.8/dns-query#🔰 节点选择"

  nameserver-policy:
    # 中国大陆及本地私有域名：使用国内 DNS
    "geosite:cn,private": *domestic_dns

    # 海外 AI 及 Google 核心域名：DNS 与代理严格锁死在 AI 专用组
    "rule-set:overseas_ai":
      - "https://1.1.1.1/dns-query#👽 AI专用"
      - "https://8.8.8.8/dns-query#👽 AI专用"
    "geosite:google":
      - "https://1.1.1.1/dns-query#👽 AI专用"
      - "https://8.8.8.8/dns-query#👽 AI专用"

  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - localhost
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "ntp.*.com"
    - time1.cloud.tencent.com

proxy-providers:
  "✈️ 我的机场":
    type: http
    url: "https://feed.iggv5.com/c/76c8d23a-f597-4f5a-a0c0-3bf2ccd93344/platform/clash/iGG-iGuge"
    interval: 3600
