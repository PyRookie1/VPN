allow-lan: false
bind-address: 127.0.0.1
mixed-port: 7890
mode: rule
log-level: info

external-controller: 127.0.0.1:9090

ipv6: false
unified-delay: true
tcp-concurrent: true

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  use-system-hosts: true

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 180.76.76.76

  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  fallback:
    - "https://1.1.1.1/dns-query#♻️ 自动选择"
    - "https://8.8.8.8/dns-query#♻️ 自动选择"

  fallback-filter:
    geoip: true
    geoip-code: CN
    domain:
      - +.chatgpt.com
      - +.openai.com
      - +.oaistatic.com
      - +.oaiusercontent.com
      - +.oaistatsig.com
      - +.openaimerge.com

  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - localhost
    - +.msftconnecttest.com
    - +.msftncsi.com
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "ntp.*.com"
    - time1.cloud.tencent.com

proxy-providers:
  # 先在机场后台重置订阅链接，再将新链接填入此处。
  "✈️ 我的机场":
    type: http
    url: &airport_url "REPLACE_WITH_NEW_SUBSCRIPTION_URL"
    interval: 3600
    path: ./wodejichang.yaml
    health-check:
      enable: true
      interval: 300
      timeout: 5000
      lazy: true
      url: https://www.gstatic.com/generate_204
      expected-status: 204

  # 与通用 provider 使用同一订阅，但节点名前加 [GPT]，并排除不适用地区。
  "👽 ChatGPT机场":
    type: http
    url: *airport_url
    interval: 3600
    path: ./wodejichang-chatgpt.yaml
    filter: '(?i)(🇹🇼|台湾|台灣|Taiwan|Taipei|台北|臺北|Kaohsiung|高雄|Taichung|台中|臺中|\bTW\b|\bTWN\b)'
    override:
      additional-prefix: "[GPT] "
    health-check:
      enable: true
      interval: 600
      timeout: 5000
      lazy: true
      url: https://chatgpt.com/cdn-cgi/trace
      expected-status: 200

proxy-groups:
  # ==============================
  # 通用节点
  # ==============================
  - name: "🔰 节点选择"
    type: select
    proxies:
      - "♻️ 自动选择"
      - "⚖️ 负载均衡"
      - "🎯 本地直连"
    use:
      - "✈️ 我的机场"

  # ==============================
  # ChatGPT：纯手动选择
  #
  # Clash Verge 可以点击测速并按延迟排序；测速不会自动切换节点。
  # 首次加载配置后，请在本组中手动选择一个具体的 [GPT] 节点。
  # ==============================
  - name: "👽 ChatGPT"
    type: select
    use:
      - "👽 ChatGPT机场"

  # ==============================
  # 通用自动选择
  # ==============================
  - name: "♻️ 自动选择"
    type: url-test
    use:
      - "✈️ 我的机场"
    tolerance: 50

  - name: "⚖️ 负载均衡"
    type: load-balance
    strategy: consistent-hashing
    use:
      - "✈️ 我的机场"

  # ==============================
  # 服务策略
  # ==============================
  - name: "🤖 AI服务"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "👽 ChatGPT"

  - name: "🌍 国外媒体"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "⚖️ 负载均衡"
      - "🎯 本地直连"
    use:
      - "✈️ 我的机场"

  - name: "🌏 国内媒体"
    type: select
    proxies:
      - "🎯 本地直连"
      - "🔰 节点选择"

  - name: "Ⓜ️ 微软服务"
    type: select
    proxies:
      - "🎯 本地直连"
      - "🔰 节点选择"
      - "♻️ 自动选择"

  - name: "📲 电报信息"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🎯 本地直连"
    use:
      - "✈️ 我的机场"

  - name: "🍎 苹果服务"
    type: select
    proxies:
      - "🎯 本地直连"
      - "🔰 节点选择"
      - "♻️ 自动选择"

  - name: SteamGame
    type: select
    proxies:
      - "🎯 本地直连"
      - "🔰 节点选择"
      - "♻️ 自动选择"

  - name: "🎯 本地直连"
    type: select
    proxies:
      - DIRECT

  - name: "🐟 漏网之鱼"
    type: select
    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "⚖️ 负载均衡"
      - "🎯 本地直连"

rules:
  # ==============================
  # 局域网 / 本机
  # ==============================
  - DOMAIN-SUFFIX,local,🎯 本地直连
  - IP-CIDR,127.0.0.0/8,🎯 本地直连,no-resolve
  - IP-CIDR,10.0.0.0/8,🎯 本地直连,no-resolve
  - IP-CIDR,172.16.0.0/12,🎯 本地直连,no-resolve
  - IP-CIDR,192.168.0.0/16,🎯 本地直连,no-resolve
  - IP-CIDR,100.64.0.0/10,🎯 本地直连,no-resolve
  - IP-CIDR6,::1/128,🎯 本地直连,no-resolve
  - IP-CIDR6,fc00::/7,🎯 本地直连,no-resolve
  - IP-CIDR6,fe80::/10,🎯 本地直连,no-resolve
  - IP-CIDR6,fd00::/8,🎯 本地直连,no-resolve
